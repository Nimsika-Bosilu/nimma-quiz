NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx

# Optional for GitHub Pages project URLs, for example /react-quiz-competition
NEXT_PUBLIC_BASE_PATH=

# Simple organizer gate for the static prototype.
# For a serious competition, use Firebase Auth admin emails + Firestore rules instead.
NEXT_PUBLIC_ADMIN_CODE=oc-react-quiz-2026
